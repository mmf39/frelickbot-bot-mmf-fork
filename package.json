{
  "name": "frelickbot",
  "version": "1.0.0",
  "description": "FrelickBot - console bot foundation (TypeScript, no web framework)",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node -r ./dist/puppeteerGroupPostPatch.js -r ./dist/lineupScheduler.js dist/index.js",
    "gotd": "tsx src/jobs/gotd.ts",
    "lineup-lock": "tsx src/jobs/lineupLock.ts",
    "lineup-announcement": "tsx src/jobs/lineupAnnouncement.ts",
    "final-scores": "tsx src/jobs/FinalScoreRecaps.ts",
    "daily-score-rankings": "tsx src/jobs/DailyScoreRankings.ts",
    "listener": "tsx src/listener.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "hashids": "^2.3.0",
    "node-cron": "^4.6.0",
    "puppeteer": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "uuid": "^14.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nlandwer/frelickbot-bot.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/nlandwer/frelickbot-bot/issues"
  },
  "homepage": "https://github.com/nlandwer/frelickbot-bot#readme"
